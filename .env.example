# RamAI Environment Configuration
# Copy this file to .env and fill in your values

# Which explanation provider to use: groq | gemini | dummy
# Leave blank to auto-pick: Groq if GROQ_API_KEY is set, else Gemini, else offline template.
LLM_PROVIDER=groq

# Groq API key (free developer tier, no credit card: https://console.groq.com/keys)
# Free limits for openai/gpt-oss-120b: 30 req/min, 1,000 req/day, 200k tokens/day.
GROQ_API_KEY=your_groq_api_key_here
# Optional override. llama-3.1-8b-instant allows 14,400 req/day if you need more volume.
GROQ_MODEL=openai/gpt-oss-120b

# Google Gemini API Key (alternative provider, https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
